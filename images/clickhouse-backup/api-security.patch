+// ValidateServerCredentials prevents the API from using empty defaults, even
+// when it is started directly instead of through the chart's startup wrapper.
+func ValidateServerCredentials(cfg *Config) error {
+	if cfg.API.Username == "" || cfg.API.Password == "" {
+		return errors.New("backup API username and password must be nonempty")
+	}
+	if cfg.ClickHouse.Username == "" || cfg.ClickHouse.Password == "" {
+		return errors.New("backup database username and password must be nonempty")
+	}
+	return nil
+}
