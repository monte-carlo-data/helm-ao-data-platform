+func TestBackupAPIAuthDoesNotLogCredentials(t *testing.T) {
+	for _, tc := range []struct {
+		name, username, password, query, rawHeader string
+		configUser, configPassword                 string
+		want                                       int
+	}{
+		{name: "wrong header password", username: "header-user-secret", password: "wrong-header-secret", want: 401},
+		{name: "wrong query password", query: "?user=query-user-secret&pass=wrong-query-secret", want: 401},
+		{name: "malformed header", rawHeader: "Basic malformed-header-secret", want: 401},
+		{name: "no credentials", want: 401},
+		{name: "valid header", username: "configured-user-secret", password: "configured-password-secret", want: 204},
+		{name: "valid query", query: "?user=configured-user-secret&pass=configured-password-secret", want: 204},
+		{name: "empty configured password", username: "configured-user-secret", configPassword: "empty", want: 401},
+		{name: "empty configured username", password: "configured-password-secret", configUser: "empty", want: 401},
+		{name: "empty configured credentials", configUser: "empty", configPassword: "empty", want: 401},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var output bytes.Buffer
+			original := log.Logger
+			log.Logger = zerolog.New(&output)
+			t.Cleanup(func() { log.Logger = original })
+			cfg := config.DefaultConfig()
+			cfg.API.Username, cfg.API.Password = "configured-user-secret", "configured-password-secret"
+			if tc.configUser == "empty" {
+				cfg.API.Username = ""
+			}
+			if tc.configPassword == "empty" {
+				cfg.API.Password = ""
+			}
+			api := &APIServer{config: cfg}
+			router := mux.NewRouter()
+			router.Use(api.basicAuthMiddleware)
+			router.HandleFunc("/backup/status/{name}", func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(http.StatusNoContent)
+			})
+			request := httptest.NewRequest(http.MethodGet, "http://api/backup/status/path-secret"+tc.query, nil)
+			if tc.username != "" || tc.password != "" {
+				request.SetBasicAuth(tc.username, tc.password)
+			}
+			if tc.rawHeader != "" {
+				request.Header.Set("Authorization", tc.rawHeader)
+			}
+			response := httptest.NewRecorder()
+			router.ServeHTTP(response, request)
+			if response.Code != tc.want {
+				t.Fatalf("status = %d, want %d", response.Code, tc.want)
+			}
+			for _, secret := range []string{"configured-user-secret", "configured-password-secret", "header-user-secret", "wrong-header-secret", "query-user-secret", "wrong-query-secret", "malformed-header-secret", "path-secret", "?user=", "http://api"} {
+				if strings.Contains(output.String(), secret) {
+					t.Fatalf("request or configured credential appeared in logs")
+				}
+			}
+			if !strings.Contains(output.String(), "/backup/status/{name}") {
+				t.Fatal("logs should identify the route template")
+			}
+			if tc.want == 401 && !strings.Contains(output.String(), `"status":401`) {
+				t.Fatal("logs should identify the refusal status")
+			}
+		})
+	}
+}
