+package config
+
+import "testing"
+
+func TestBackupServerCredentials(t *testing.T) {
+	for _, field := range []string{"none", "API username", "API password", "database username", "database password"} {
+		t.Run(field, func(t *testing.T) {
+			cfg := DefaultConfig()
+			cfg.API.Username, cfg.API.Password = "backup", "api-password"
+			cfg.ClickHouse.Username, cfg.ClickHouse.Password = "backup", "database-password"
+			switch field {
+			case "API username":
+				cfg.API.Username = ""
+			case "API password":
+				cfg.API.Password = ""
+			case "database username":
+				cfg.ClickHouse.Username = ""
+			case "database password":
+				cfg.ClickHouse.Password = ""
+			}
+			err := ValidateServerCredentials(cfg)
+			if (err != nil) != (field != "none") {
+				t.Fatalf("credential check = %v for missing %s", err, field)
+			}
+		})
+	}
+}
+
+func TestBackupConfiguredTimeout(t *testing.T) {
+	for _, tc := range []struct {
+		duration string
+		valid    bool
+	}{{"10800s", true}, {"3h", true}, {"4h", true}, {"0s", false}, {"-1s", false}} {
+		t.Run(tc.duration, func(t *testing.T) {
+			cfg := DefaultConfig()
+			cfg.ClickHouse.UseEmbeddedBackupRestore = true
+			cfg.ClickHouse.Timeout = tc.duration
+			if err := ValidateConfig(cfg); (err == nil) != tc.valid {
+				t.Fatalf("timeout validation = %v, valid should be %t", err, tc.valid)
+			}
+		})
+	}
+}
