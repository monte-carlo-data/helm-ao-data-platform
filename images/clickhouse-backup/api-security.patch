+func TestBackupAPIRejectsEmptyReloadCredentials(t *testing.T) {
+	for _, key := range []string{"api", "clickhouse"} {
+		t.Run(key, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "config.yml")
+			contents := "general:\n  disable_environment_override: true\napi:\n  username: backup\n  password: api-secret\nclickhouse:\n  username: backup\n  password: database-secret\n"
+			if key == "api" {
+				contents = strings.Replace(contents, "password: api-secret", `password: ""`, 1)
+			} else {
+				contents = strings.Replace(contents, "password: database-secret", `password: ""`, 1)
+			}
+			if err := os.WriteFile(path, []byte(contents), 0600); err != nil {
+				t.Fatal(err)
+			}
+			previous := config.DefaultConfig()
+			previous.API.Username, previous.API.Password = "backup", "previous-secret"
+			api := &APIServer{config: previous, configPath: path}
+			if _, err := api.ReloadConfig(nil, "test"); err == nil {
+				t.Fatal("empty reloaded credentials were accepted")
+			}
+			if api.GetConfig() != previous {
+				t.Fatal("invalid configuration replaced the prior valid configuration")
+			}
+		})
+	}
+}
